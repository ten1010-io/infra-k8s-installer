pipeline {
    agent any

    environment {
        REPO = "git@github.com:ten1010-io/aipub-ten-cluster-CD.git"
        BRANCH = "main"
    }

    stages {
        stage('Clone Repo') {
            steps {
                sh '''
                rm -rf repo
                git clone $REPO repo
                '''
            }
        }

        stage('Pull Latest') {
            steps {
                sh '''
                cd repo
                git pull origin $BRANCH
                '''
            }
        }

        stage('Modify File') {
            steps {
                sh '''
                cd repo
                mkdir -p infra
                echo "test git" > infra/test.txt
                '''
            }
        }

        stage('Commit & Push') {
            steps {
                sh '''
                cd repo

                git config user.email "jenkins@local"
                git config user.name "jenkins"

                git add infra/test.txt

                # 변경 없을 때 에러 방지
                git commit -m "test: add test.txt from jenkins" || echo "no changes"

                git push origin $BRANCH
                '''
            }
        }
    }

    post {
        success {
            echo '🎉 Git push까지 정상 완료!'
        }
        failure {
            echo '❌ 실패 - SSH / 권한 / known_hosts 확인 필요'
        }
    }
}
